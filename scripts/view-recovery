#!/bin/sh
set -eu

if [ -z "${INCUS_APPS_VAULT_PASSWORD:-}" ]; then
  printf 'Ansible Vault password: ' >&2
  stty -echo
  trap 'stty echo' EXIT HUP INT TERM
  IFS= read -r INCUS_APPS_VAULT_PASSWORD </dev/tty
  stty echo
  trap - EXIT HUP INT TERM
  printf '\n' >&2
  export INCUS_APPS_VAULT_PASSWORD
fi

exec ansible-vault view \
  --vault-password-file "$(dirname "$0")/vault-password-client" \
  "$(dirname "$0")/../recovery/openbao.vault.yml"
