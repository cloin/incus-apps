[Unit]
Description=Semaphore UI GitOps controller
Documentation=https://docs.semaphoreui.com/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=semaphore
Group=semaphore
Environment=HOME=/home/semaphore
Environment=PATH={{ semaphore_venv_path }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ANSIBLE_COLLECTIONS_PATH={{ semaphore_collections_path }}
ExecStart=/usr/bin/semaphore server --config {{ semaphore_config_path }}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

